<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- DeviceDefault on Wear OS 2 = the platform watch theme (dark, swipe-to-dismiss). -->
    <style name="Theme.BioFocus" parent="@android:style/Theme.DeviceDefault">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>

    <style name="BioFocus.Button" parent="@android:style/Widget.DeviceDefault.Button">
        <item name="android:background">@drawable/btn_pill</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>

    <style name="BioFocus.Button.Primary">
        <item name="android:background">@drawable/btn_pill_primary</item>
        <item name="android:textColor">@color/bg</item>
    </style>

    <style name="BioFocus.Stepper" parent="BioFocus.Button">
        <item name="android:minHeight">@dimen/stepper_btn</item>
        <item name="android:minWidth">@dimen/stepper_btn</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:textSize">@dimen/text_title</item>
    </style>
</resources>
